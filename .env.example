# Copy to .env, replace the placeholders with sandbox values, then run the SSR server.
# Never expose the integrity secret to Angular or commit the local .env file.
WOMPI_PUBLIC_KEY=pub_test_REPLACE_WITH_SANDBOX_PUBLIC_KEY
WOMPI_INTEGRITY_SECRET=test_integrity_REPLACE_WITH_SANDBOX_SECRET
WOMPI_REDIRECT_URL=http://localhost:4000/
